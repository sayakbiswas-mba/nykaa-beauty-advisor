# OPENAI_API_KEY = "sk-..."
# OPENAI_MODEL = "gpt-4o-mini"
# ANTHROPIC_API_KEY = "sk-ant-..."
# ANTHROPIC_MODEL = "claude-haiku-5-5"
# CHECKOUT_BASE_URL = "https://your-store.example.com/checkout?sku="
